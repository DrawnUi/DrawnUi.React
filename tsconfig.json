{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "drawnui-react": ["src/react/index.tsx"],
      "drawnui-react/core": ["src/index.ts"],
      "drawnui-react-add3d": ["add3d/src/react.tsx"],
      "drawnui-react-add3d/core": ["add3d/src/index.ts"]
    }
  },
  "include": ["src", "samples", "add3d"]
}
